{
  "$schema": "./schema.json",
  "defaultLang": "en",
  "userInfo": {
    "jwtStorageKey": "primoExploreJwt",
    "jwtNameClaim": "displayName",
    "endpoint": "/primaws/rest/priv/myaccount/personal_settings?vid={vid}"
  },
  "lastSearch": {
    "storageKeyPrefix": "ec:lastSearch:",
    "resultsPath": "/search",
    "homePath": "/home",
    "stripParams": [
      "useLocalCustomPackage",
      "_customAssetCheck"
    ],
    "maxAgeDays": 30
  },
  "askALibrarian": {
    "triggerUrlPrefixes": [
      "https://ec.europa.eu/libraries/pages/askalibrarian/"
    ],
    "formfillScriptUrl": "https://ec.europa.eu/libraries/libanswers/libanswers.script.js",
    "libanswersHost": "https://ec-europa-eu.libanswers.com",
    "widgetId": {
      "en": "8158",
      "fr": "8158",
      "de": "8158"
    },
    "prefillFromUser": {
      "pname": "displayName",
      "pemail": "email"
    },
    "prefillStatic": {},
    "context": {
      "field": "pdetails",
      "titleSelector": "nde-record-title h3",
      "marker": {
        "en": "**TYPE ABOVE THIS LINE**",
        "fr": "**ÉCRIVEZ AU-DESSUS DE CETTE LIGNE**",
        "de": "**BITTE OBERHALB DIESER ZEILE SCHREIBEN**"
      },
      "labels": {
        "en": {
          "title": "Item title",
          "mmsId": "MMS ID",
          "recordId": "Record ID",
          "searchTerms": "Search terms",
          "link": "Link"
        },
        "fr": {
          "title": "Titre",
          "mmsId": "MMS ID",
          "recordId": "ID de la notice",
          "searchTerms": "Termes de recherche",
          "link": "Lien"
        },
        "de": {
          "title": "Titel",
          "mmsId": "MMS-ID",
          "recordId": "Datensatz-ID",
          "searchTerms": "Suchbegriffe",
          "link": "Link"
        }
      }
    },
    "title": {
      "en": "Ask a librarian",
      "fr": "Demander à un bibliothécaire",
      "de": "Fragen Sie die Bibliothek"
    },
    "closeLabel": {
      "en": "Close",
      "fr": "Fermer",
      "de": "Schließen"
    },
    "loadingLabel": {
      "en": "Loading the form…",
      "fr": "Chargement du formulaire…",
      "de": "Formular wird geladen…"
    },
    "errorLabel": {
      "en": "The form could not be loaded. Please try again or open the page directly:",
      "fr": "Le formulaire n’a pas pu être chargé. Réessayez ou ouvrez la page directement :",
      "de": "Das Formular konnte nicht geladen werden. Bitte versuchen Sie es erneut oder öffnen Sie die Seite direkt:"
    },
    "resetOnClose": true,
    "hideFields": [],
    "formCssPath": "assets/ask-librarian/form.css"
  },
  "libchat": {
    "libanswersHost": "https://ec-europa-eu.libanswers.com",
    "hash": "c78ee6cc0e28c62ba3c16869ef1d7fc75036cf356cda6bfbab938f6251e74017",
    "floatButtonSelector": ".s-lch-widget-float-btn",
    "iframeSelector": "[id^=\"s-lch-widget\"] iframe"
  },
  "resourceSharing": {
    "forceFormat": "digital",
    "hideFormatField": true,
    "autoCheckAvailability": true,
    "formatFieldSelector": "[data-qa=\"almaResourceSharing.format\"]",
    "checkAvailabilitySelector": "nde-formly-check-availability-button button",
    "formatValues": {
      "physical": {
        "values": [
          "PHYSICAL",
          "physical",
          "PHYSICAL_NON_RETURNABLE"
        ],
        "labels": [
          "Physical",
          "Physique",
          "Physisch"
        ],
        "position": 0
      },
      "digital": {
        "values": [
          "DIGITAL",
          "digital",
          "ELECTRONIC"
        ],
        "labels": [
          "Digital",
          "Elektronisch",
          "Numérique",
          "Électronique"
        ],
        "position": 1
      },
      "photocopy": {
        "values": [
          "PHOTOCOPY",
          "photocopy",
          "COPY"
        ],
        "labels": [
          "Fotokopie",
          "Kopie",
          "Photocopie",
          "Photocopy"
        ],
        "position": 2
      }
    }
  }
}
