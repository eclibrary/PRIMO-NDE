  "network": {
    "enabled": true,
    "pingUrl": "https://intragate.ec.europa.eu/eclibrarytools/ping",
    "timeoutMs": 3000,
    "checkingText": {
      "en": "Checking the connection…",
      "fr": "Vérification de la connexion…",
      "de": "Verbindung wird geprüft…"
    },
    "insideText": {
      "en": "<p>You are connected to the Commission network.</p>",
      "fr": "<p>Vous êtes connecté(e) au réseau de la Commission.</p>",
      "de": "<p>Sie sind mit dem Netz der Kommission verbunden.</p>"
    },
    "outsideText": {
      "en": "<p><strong>You are not connected to the Commission network.</strong></p><p>Possible causes: you are working from home or on the move without the VPN, the VPN is not connected (yet), or a browser extension blocks the check.</p><p>What you can do: connect to the Commission VPN and click the button again. Library on the Go titles can be read without it.</p>",
      "fr": "<p><strong>Vous n'êtes pas connecté(e) au réseau de la Commission.</strong></p><p>Causes possibles : vous travaillez à domicile ou en déplacement sans VPN, le VPN n'est pas (encore) connecté, ou une extension du navigateur bloque la vérification.</p><p>Que faire : connectez-vous au VPN de la Commission et cliquez à nouveau sur le bouton. Les titres Library on the Go sont accessibles sans VPN.</p>",
      "de": "<p><strong>Sie sind nicht mit dem Netz der Kommission verbunden.</strong></p><p>Mögliche Ursachen: Sie arbeiten von zu Hause oder unterwegs ohne VPN, das VPN ist (noch) nicht verbunden, oder eine Browser-Erweiterung blockiert die Prüfung.</p><p>Was Sie tun können: Verbinden Sie sich mit dem VPN der Kommission und klicken Sie erneut auf die Schaltfläche. Titel von Library on the Go sind auch ohne VPN lesbar.</p>"
    },
    "offlineText": {
      "en": "<p><strong>Your device is not connected to the internet.</strong></p><p>Check your Wi-Fi or network cable, then try again.</p>",
      "fr": "<p><strong>Votre appareil n'est pas connecté à Internet.</strong></p><p>Vérifiez votre Wi-Fi ou votre câble réseau, puis réessayez.</p>",
      "de": "<p><strong>Ihr Gerät ist nicht mit dem Internet verbunden.</strong></p><p>Prüfen Sie WLAN oder Netzwerkkabel und versuchen Sie es erneut.</p>"
    },
    "blockedText": {
      "en": "<p><strong>The connection could not be checked in this browser.</strong></p><p>Please contact the library and mention the technical details below.</p>",
      "fr": "<p><strong>La connexion n'a pas pu être vérifiée dans ce navigateur.</strong></p><p>Veuillez contacter la bibliothèque en mentionnant les détails techniques ci-dessous.</p>",
      "de": "<p><strong>Die Verbindung konnte in diesem Browser nicht geprüft werden.</strong></p><p>Bitte wenden Sie sich an die Bibliothek und nennen Sie die technischen Details unten.</p>"
    },
    "detailsLabel": {
      "en": "Technical details",
      "fr": "Détails techniques",
      "de": "Technische Details"
    },
    "closeLabel": {
      "en": "Close",
      "fr": "Fermer",
      "de": "Schließen"
    }
  },
